PORT = 5000

# CORS Allowed Origins
ORIGIN = ['http://localhost:3000','http://localhost:5173']

# MongoDB connection URI
MONGODB_URI = 'mongodb+srv://<username>:<password>@cluster0.mongodb.net/lms?retryWrites=true&w=majority'

# Cloudinary configuration for media uploads
CLOUDINARY_CLOUD_NAME = your_cloudinary_cloud_name
CLOUDINARY_API_KEY = your_cloudinary_api_key
CLOUDINARY_API_SECRET = your_cloudinary_api_secret

# Redis configuration for caching and session management
REDIS_URL = 'rediss://default:your_redis_token@your_instance.upstash.io:6379'

# JWT Secrets (Generate secure random secrets in production)
ACTIVATION_SECRET = your_jwt_activation_secret
ACCESS_TOKEN_SECRET = your_jwt_access_token_secret
REFRESH_TOKEN_SECRET = your_jwt_refresh_token_secret
RESET_PASSWORD_SECRET = your_jwt_reset_password_secret

# Token Expiration (in days)
ACCESS_TOKEN_EXPIRES = 7
REFRESH_TOKEN_EXPIRES = 30

# Email Configuration (Gmail SMTP)
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 465
SMTP_SERVICE = gmail
SMTP_MAIL = your_email@gmail.com
SMTP_USER = your_email@gmail.com
SMTP_PASSWORD = your_16_digit_app_password
SMTP_FROM_NAME = "E-Learning"
